{
  "name": "pixeljury",
  "version": "0.1.5",
  "description": "Visual QA CLI for AI-built frontends that renders pages, finds design and accessibility issues, and writes agent-ready fix prompts.",
  "type": "module",
  "bin": {
    "pixeljury": "bin/pixeljury.js"
  },
  "files": [
    "bin",
    "src",
    "rubric.md"
  ],
  "keywords": [
    "ai-slop",
    "visual-qa",
    "design-qa",
    "frontend-qa",
    "ai-ui",
    "design-review",
    "design-linter",
    "accessibility",
    "wcag",
    "mobile-overflow",
    "playwright",
    "screenshot",
    "vision-ai",
    "cursor",
    "claude-code",
    "codex",
    "cli"
  ],
  "homepage": "https://github.com/gchahal1982/pixeljury#readme",
  "bugs": {
    "url": "https://github.com/gchahal1982/pixeljury/issues"
  },
  "dependencies": {
    "pixeljury-core": "^0.1.5",
    "pixeljury-vision": "^0.1.5"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').copyFileSync('../../rubric.md','rubric.md')\"",
    "postpack": "node -e \"require('node:fs').rmSync('rubric.md',{force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
